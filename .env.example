# Local persistent PostgreSQL. scripts/setup-db.ts can create a loopback-only instance.
DATABASE_URL=
# Isolated database for real PostgreSQL integration checks. Never point this at production.
TEST_DATABASE_URL=
# If DATABASE_URL is absent, the development app uses embedded PostgreSQL at .data/pglite.
APP_URL=http://127.0.0.1:3000
DATA_DIR=.data
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
RECEIPT_PRIVATE_KEY=
RECONCILE_SECRET=
CHECKOUT_ACCESS_SECRET=
# AG Studio licence is intentionally public in the browser bundle; it is not an API secret.
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
